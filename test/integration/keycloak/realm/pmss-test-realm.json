{
  "realm": "pmss-test",
  "enabled": true,
  "accessTokenLifespan": 300,
  "defaultDefaultClientScopes": [
    "basic"
  ],
  "defaultOptionalClientScopes": [],
  "roles": {
    "realm": [
      {
        "name": "security-admin",
        "description": "May change MQTT permissions (scope write)"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-security-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "phylax-mqtt-security-service",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-security-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "phylax-mqtt-security-service",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "write",
      "roles": [
        "security-admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "phylax-mqtt-security-service",
      "fullScopeAllowed": false,
      "enabled": true,
      "publicClient": false,
      "secret": "unused",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "msm-test-rw",
      "fullScopeAllowed": false,
      "enabled": true,
      "publicClient": false,
      "secret": "msm-test-rw-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic",
        "read",
        "write"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "msm-test-ro",
      "fullScopeAllowed": false,
      "enabled": true,
      "publicClient": false,
      "secret": "msm-test-ro-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic",
        "read"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "msm-test-rw-norole",
      "fullScopeAllowed": false,
      "enabled": true,
      "publicClient": false,
      "secret": "msm-test-rw-norole-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic",
        "read",
        "write"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "pmss-api-tester",
      "fullScopeAllowed": false,
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "pmss-api-tester-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "${PMSS_API_TESTER_URL:http://127.0.0.1:8080}/auth/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PMSS_API_TESTER_URL:http://127.0.0.1:8080}/",
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [
        "read"
      ]
    },
    {
      "clientId": "pmss-cli",
      "fullScopeAllowed": false,
      "name": "Administrator via curl (device authorization grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [
        "read",
        "write"
      ]
    },
    {
      "clientId": "tasmofleet-test",
      "fullScopeAllowed": false,
      "enabled": true,
      "publicClient": false,
      "secret": "tasmofleet-test-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [
        "read",
        "write"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Test",
      "realmRoles": [
        "security-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Test",
      "realmRoles": [],
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-msm-test-rw",
      "enabled": true,
      "serviceAccountClientId": "msm-test-rw",
      "realmRoles": [
        "security-admin"
      ]
    },
    {
      "username": "service-account-msm-test-ro",
      "enabled": true,
      "serviceAccountClientId": "msm-test-ro",
      "realmRoles": []
    },
    {
      "username": "service-account-msm-test-rw-norole",
      "enabled": true,
      "serviceAccountClientId": "msm-test-rw-norole",
      "realmRoles": []
    }
  ],
  "browserFlow": "browser-security-admin-2fa",
  "authenticationFlows": [
    {
      "alias": "browser-security-admin-2fa",
      "description": "Browser and device sign-in; OTP required for security-admin (design 7.5, SEC-36)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser-security-admin-2fa forms",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-security-admin-2fa forms",
      "description": "Username and password, then the second factor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser-security-admin-2fa otp",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-security-admin-2fa otp",
      "description": "OTP for users with realm role security-admin; set up at the first sign-in",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "role security-admin",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "role security-admin",
      "config": {
        "condUserRole": "security-admin",
        "negate": "false"
      }
    }
  ]
}